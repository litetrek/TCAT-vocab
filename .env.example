# Copy this file to .env (local dev) and fill in real values.
# Never commit the actual .env file.

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com   # From Google Cloud Console > OAuth 2.0 Client IDs
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret                      # From the same OAuth client
SECRET_KEY=replace-with-a-long-random-string                             # Flask session signing key; any random string
ANTHROPIC_API_KEY=sk-ant-your-key-here                                   # From console.anthropic.com
SUPER_ADMIN_EMAIL=you@example.com                                        # Email granted permanent admin role
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/callback                       # OAuth callback URL; differs between dev and prod
FLASK_ENV=development                                                    # "development" or "production"
PORT=5000                                                                 # Local dev server port (unused on GreenGeeks CGI)
DATABASE_URL=postgresql://postgres.XXXX:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres  # local scripts only (migrate_from_sheets.py); NOT used by Flask app
SUPABASE_URL=https://XXXX.supabase.co                                    # Required by Flask app (supabase-py REST client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key                          # Required by Flask app (bypasses RLS; server-side only)
TRANSLATION_MIN_ROLE=viewer                                              # Minimum role for translation (Books) module access — "viewer" = everyone; raise to "admin" to re-gate during future dev work
VOYAGE_API_KEY=                                                          # optional — Voyage AI embeddings (voyage-3, 1024-dim)
OPENAI_API_KEY=                                                          # optional — OpenAI embeddings (text-embedding-3-small, 1536-dim)
EMBEDDING_PROVIDER=voyage                                                # which provider's column to query for RAG retrieval at translate time: voyage | openai
