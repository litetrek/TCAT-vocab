# Copy this file to .env (local dev) and fill in real values.
# Never commit the actual .env file.

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com   # From Google Cloud Console > OAuth 2.0 Client IDs
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret                      # From the same OAuth client
SECRET_KEY=replace-with-a-long-random-string                             # Flask session signing key; any random string
ANTHROPIC_API_KEY=sk-ant-your-key-here                                   # From console.anthropic.com
SHEET_ID=your-google-sheet-id                                            # The ID from the Google Sheet's URL
SUPER_ADMIN_EMAIL=you@example.com                                        # Email granted permanent admin role
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/callback                       # OAuth callback URL; differs between dev and prod
FLASK_ENV=development                                                    # "development" or "production"
PORT=5000                                                                 # Local dev server port (unused on GreenGeeks CGI)
